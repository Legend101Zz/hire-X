# =============================================================================
# NEURALEAP API - ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
# Secret key for JWT token signing (IMPORTANT: Change this in production!)
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-very-secure-secret-key-change-this-in-production

# JWT token expiration time in minutes (default: 30)
JWT_EXPIRE_MINUTES=30


# -----------------------------------------------------------------------------
# AI Model Configuration (OpenRouter)
# -----------------------------------------------------------------------------
# OpenRouter API Key for AI model access
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# AI Model to use (default: openai/gpt-4o-mini)
# Options: openai/gpt-4o-mini, openai/gpt-4o, anthropic/claude-3-sonnet, etc.
AI_MODEL_NAME=openai/gpt-4o-mini


# -----------------------------------------------------------------------------
# MongoDB - NeuralLeap Database (Users, Prompts, Logs)
# -----------------------------------------------------------------------------
# Main application database URL
# Local: mongodb://localhost:27017/
# Remote: mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_URL=mongodb://localhost:27017/

# Database name for users, prompts, and logs
DATABASE_NAME=neuraleap


# -----------------------------------------------------------------------------
# MongoDB - Profiles Database (Candidate Profiles)
# -----------------------------------------------------------------------------
# Profiles database URL (can be same or different from main database)
PROFILES_DB_URL=mongodb://localhost:27017

# Database name for candidate profiles
PROFILES_DB_NAME=mydatabase


# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Redis host
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis database number (0-15)
REDIS_DB=0

# Optional: Redis password (if using authentication)
# REDIS_PASSWORD=your-redis-password


# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Server host
SERVER_HOST=0.0.0.0

# Server port
SERVER_PORT=8000


# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Allowed origins for CORS (comma-separated)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com


# -----------------------------------------------------------------------------
# Optional: Logging
# -----------------------------------------------------------------------------
# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO


# =============================================================================
# EXAMPLE CONFIGURATIONS
# =============================================================================

# --- LOCAL DEVELOPMENT ---
# JWT_SECRET_KEY=dev-secret-key-local-only
# OPENROUTER_API_KEY=sk-or-v1-your-key
# AI_MODEL_NAME=openai/gpt-4o-mini
# MONGODB_URL=mongodb://localhost:27017/
# DATABASE_NAME=neuraleap
# PROFILES_DB_URL=mongodb://localhost:27017
# PROFILES_DB_NAME=mydatabase
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# --- PRODUCTION (MongoDB Atlas) ---
# JWT_SECRET_KEY=prod-super-secure-secret-key-32-chars-minimum
# OPENROUTER_API_KEY=sk-or-v1-your-production-key
# AI_MODEL_NAME=openai/gpt-4o
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# DATABASE_NAME=neuraleap
# PROFILES_DB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# PROFILES_DB_NAME=profiles_production
# REDIS_HOST=your-redis-host.com
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=your-redis-password
